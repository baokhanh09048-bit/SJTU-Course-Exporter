# Normalise line endings so the repo is pleasant to work with on any platform.
* text=auto eol=lf

# Windows-only helper scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.zip binary
*.srt text eol=lf

# Keep saved platform pages completely out of git (real course data).
*.html linguist-vendored=false
